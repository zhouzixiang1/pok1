# pok-arena 新平台公网加固配置(复制为 .env 后填写真实值)
# cp .env.example .env && chmod 600 .env

# ── 绑定 / 暴露 ──────────────────────────────────────────
POK_PLATFORM_HOST=0.0.0.0
POK_PLATFORM_PORT=50280
# 上层反向代理传入 X-Forwarded-For 时开启
POK_PLATFORM_TRUST_PROXY=0
# 上层已 HTTPS 终止时开启 Secure Cookie
POK_PLATFORM_SECURE_COOKIE=0
POK_PLATFORM_HSTS=0
POK_PLATFORM_RATE_LIMIT=1
POK_PLATFORM_MAX_CONCURRENT_MATCHES=2

# ── 阿里云企业邮 SMTP(发信)─────────────────────────────
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=postmaster@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=postmaster@example.com
SMTP_FROM_NAME=pok-arena
# 邮件验证码有效分钟数
EMAIL_CODE_TTL_MINUTES=30
