# ============================================================================
# Secret LLM credentials overlay — copy to env.runtime.local and fill in.
# ============================================================================
# This file is a template. The real env.runtime.local is gitignored and holds
# only the secret token. The systemd unit loads env.runtime first, then this
# overlay, so the real token overrides the PLACEHOLDER in env.runtime.
#
# Setup:
#   cp deploy/tencent-cloud/env.runtime.local.example \
#      deploy/tencent-cloud/env.runtime.local
#   $EDITOR deploy/tencent-cloud/env.runtime.local   # paste your token
# ============================================================================

ANTHROPIC_AUTH_TOKEN=your-glm-token-here
ANTHROPIC_API_KEY=your-glm-token-here
