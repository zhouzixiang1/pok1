# ============================================================================
# systemd unit for the national_tcp_policy_v1 evolution control plane
# (Tencent Cloud runtime — isolated tencent-cloud-runtime namespace)
# ============================================================================
# Install:
#   sudo cp deploy/tencent-cloud/pok-evolution.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pok-evolution
#
# This unit runs web/main.py in the FOREGROUND (ExecStart is the python process
# itself, NOT pokctl.sh). web/main.py's lifespan then starts orchestrator_loop
# which calls start_daemon() to spawn elo_daemon.py as a child in its own
# session. KillMode=mixed therefore stops the daemon child group AND the main
# process. Do not wrap this in pokctl.sh start — that uses nohup setsid and
# would double-fork out of systemd's cgroup.
# ============================================================================

[Unit]
Description=national TCP poker evolution control plane (tencent-cloud-runtime)
Documentation=file:///home/ubuntu/pok1/deploy/tencent-cloud/README.md
After=network-online.target
Wants=network-online.target
# Rate-limit Restart=on-failure. These MUST live in [Unit] (systemd silently
# ignores them in [Service] with "Unknown key name ... ignoring"), otherwise a
# crash loop is unbounded.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# The autonomous runtime checkout. web/main.py detects PROJECT_ROOT.name ==
# ".evolution_pok" and (with POK_CLOUD_RUNTIME=1) seeds the cloud namespace.
WorkingDirectory=/home/ubuntu/pok1/.evolution_pok

# Load POK_PYTHON, namespace vars, daemon sizing, etc. The .local file is
# gitignored and carries secret overrides (LLM token); it loads AFTER env.runtime
# so real values replace the PLACEHOLDER_* entries. It is optional (absent =>
# the committed placeholders stand, useful for a view-only diagnostic deploy).
EnvironmentFile=/home/ubuntu/pok1/deploy/tencent-cloud/env.runtime
EnvironmentFile=/home/ubuntu/pok1/deploy/tencent-cloud/env.runtime.local

# ExecStart-relevant vars must be Environment= (EnvironmentFile values are
# passed to the process env but cannot be expanded in ExecStart with ${}).
Environment=POK_PYTHON=/home/ubuntu/pok1/.venv/bin/python
Environment=HOST=127.0.0.1
Environment=PORT=8000

# Foreground launch. --no-build skips the npm frontend rebuild on every restart
# (build the frontend once; the static receipt is verified at startup).
ExecStart=/home/ubuntu/pok1/.venv/bin/python web/main.py --host 127.0.0.1 --port 8000 --no-build

# web/main.py spawns elo_daemon.py via start_new_session=True. mixed kills the
# main process with SIGTERM (daemon gets it via its own session) and the control
# group on timeout. Give the orchestrator a graceful shutdown window.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=45

Restart=on-failure
RestartSec=10

# Standard output/error -> journald (view with: journalctl -u pok-evolution -f).
# The app also writes rotating logs to web/logs/app.log and server.stdout.log
# (the latter is rotated by scripts/pok.logrotate).
StandardOutput=journal
StandardError=journal

# Resource sanity for a small VM: evolution forks many native-TCP match workers.
LimitNOFILE=4096

# Memory containment for the web/main.py heap (it grows ~2GiB over ~7h; root
# cause under investigation). Without a cgroup limit the growth hits whole-box
# global OOM and takes down the ZCode client too. MemoryHigh makes the kernel
# reclaim aggressively above 2400M; MemoryMax=2800M is a hard kill that systemd
# auto-restarts (Restart=on-failure), isolating the leak from the rest of the
# box. Legitimate bursts (main ~1G + 2x claude ~0.8G + daemon ~0.25G ~= 2.05G)
# fit under the cap. Tunable; swap was also raised to 6G (2G + 4G swapfile2).
MemoryHigh=2400M
MemoryMax=3500M

# Bubblewrap (bwrap) sandboxing notes:
#
# The candidate quality-gate runtime import and the typed runtime probe both
# execute candidate policy.py inside a bwrap sandbox that unshares
# user/ipc/pid/net/uts/cgroup namespaces (--unshare-user --unshare-net ...).
#
# IMPORTANT: do NOT set AmbientCapabilities=CAP_NET_ADMIN here. An ambient
# capability on the service process makes bwrap's --assert-userns-disabled
# check fail with "Unexpected capabilities but not setuid, old file caps
# config?". With unprivileged user namespaces enabled (see the AppArmor
# prerequisite in deploy/tencent-cloud/README.md), bwrap creates a user
# namespace that grants CAP_NET_ADMIN *inside* the new namespace, so
# --unshare-net's loopback setup works without any ambient capability on the
# parent process. The earlier AmbientCapabilities=CAP_NET_ADMIN was a
# workaround for when AppArmor blocked user namespaces; now that the sysctl
# fix is applied, it is both unnecessary and harmful.

[Install]
WantedBy=multi-user.target
