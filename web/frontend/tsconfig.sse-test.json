{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "./node_modules/.tmp/sse-tests",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/lib/eventSourceController.ts",
    "src/lib/dataStreamController.ts",
    "src/lib/evolutionStreamController.ts",
    "src/lib/epochStreamAuthority.ts",
    "src/lib/controlRuntimeState.ts",
    "src/lib/pipelinePresentation.ts",
    "src/lib/canonicalGenerationIdentity.ts",
    "src/lib/stabilityView.ts",
    "src/constants/pipeline.ts",
    "src/api/pipeline.ts",
    "src/api/types.ts",
    "src/api/control.ts",
    "src/api/agentActivity.ts",
    "src/api/strengthJobs.ts",
    "src/api/officialJobs.ts",
    "src/domain/agentActivityView.ts",
    "src/domain/strengthJobView.ts",
    "src/domain/evidenceAuthority.ts",
    "src/domain/failureRecoveryView.ts",
    "src/domain/operatorSituationView.ts"
  ]
}
