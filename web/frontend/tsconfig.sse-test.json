{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "./node_modules/.tmp/sse-tests",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/lib/eventSourceController.ts",
    "src/lib/dataStreamController.ts",
    "src/lib/evolutionStreamController.ts",
    "src/lib/epochStreamAuthority.ts",
    "src/lib/controlRuntimeState.ts"
  ]
}
