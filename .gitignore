# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Bot battle results (engine output)
results/*.json

# Evolution results — only LLM logs and round outputs excluded
evolution_workspace/results/**/logs/
evolution_workspace/results/round_*/

# Runtime data (daemon writes, battle results, LLM logs)
web/core/results/

# Orchestrator logs
web/logs/

# Frontend build output
web/server/static/

# Bot worker backup files
**/main_backup.py

# Bot graveyard
bots/graveyard/

# Bot sentinel files (local-only, daemon uses to track active bots)
*.completed

# Claude Code worktrees
.claude/worktrees/

# Per-generation worker task briefs — transient (Master LLM writes, Workers
# read at runtime per master_prompt.md). Stale ones archived to
# archive/task_context/bots/. Ignore active locations to stop git churn.
.task_context/

# Playwright MCP runtime artifacts (screenshots/console logs); archived to
# archive/clutter/.playwright-mcp/
.playwright-mcp/

# Stray root npm lockfile (no root package.json; real one is web/frontend/).
# Archived to archive/clutter/package-lock.json
/package-lock.json

# Archived runtime/log data — preserved on disk, NOT tracked (origins were the
# gitignored web/logs/ and web/core/results/). Keeping them out of git avoids
# committing bulky logs/replays/.bak into history.
archive/logs/
archive/forensic/
archive/clutter/

# Local third-party reference checkouts. Keep these repos on disk for research,
# but do not stage their nested git histories or vendored source trees.
ref/llm_evolution/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# LLM credentials
.env
rl/checkpoints/
rl/checkpoints/
rl/checkpoints/
