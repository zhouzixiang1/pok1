# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# One-time pre-policy-epoch runtime debris. Active code never writes this root;
# the acknowledged epoch reset archives any existing JSON before v143 starts.
results/*.json

# Runtime data (daemon writes, battle results, LLM logs)
web/core/results/

# Orchestrator logs
web/logs/

# Frontend build output
web/server/static/

# Bot sentinel files (local-only, daemon uses to track active bots)
*.completed

# Claude Code worktrees are separate local tool checkouts, like Codex
# worktrees; they are never active protocol/evidence inputs.
.claude/worktrees/

# Codex task worktrees. These are separate Git worktrees and must be managed
# with git worktree remove/prune, not staged from the operator checkout.
.codex_worktrees/

# Nested evolution runtime clone. This is a separate checkout used only for the
# autonomous evolution process; sync it through git/origin, never by staging it
# from the outer checkout.
.evolution_pok/

# Per-generation worker task briefs — transient (Master LLM writes, Workers
# read at runtime per master_prompt.md). Stale ones archived to
# archive/task_context/bots/. Ignore active locations to stop git churn.
.task_context/

# Playwright MCP runtime artifacts (screenshots/console logs); archived to
# archive/clutter/.playwright-mcp/
.playwright-mcp/

# Stray root npm lockfile (no root package.json; real one is web/frontend/).
# Archived to archive/clutter/package-lock.json
/package-lock.json

# Archived runtime/log data — preserved on disk, NOT tracked (origins were the
# gitignored web/logs/ and web/core/results/). Keeping them out of git avoids

# THP match output from local national TCP platform
records/
sever/records/

# Research H2H evaluation results
scripts/research_eval/results/
# H2H eval scripts that drive the three-bot-consolidation research bots
# (bots/research_native_lab/ lives only on that branch; the run_*.py scripts
# are inert on main without it). Ship them with the branch, not main.
scripts/research_eval/run_*.py
scripts/research_eval/anchor_bots.py
# committing bulky logs/replays/.bak into history.
archive/logs/
archive/forensic/
archive/clutter/
archive/evolution_epochs/*/
!archive/evolution_epochs/
!archive/evolution_epochs/README.md
# `national_native_v1` is now a committed source/docs/tests quarantine rather
# than a runtime-results dump. Keep other epoch payloads ignored, but make every
# retired authority file in this epoch visible to review and Git.
!archive/evolution_epochs/national_native_v1/
!archive/evolution_epochs/national_native_v1/**
# The negation above exposes retired source for review; keep generated Python
# caches excluded inside that now-visible archive tree.
archive/evolution_epochs/national_native_v1/**/__pycache__/
archive/evolution_epochs/national_native_v1/**/*.py[cod]
# One-time runtime epoch-reset payloads are local forensic data, not reviewed
# source quarantine. Keep them available on disk without dirtying either
# checkout or making them eligible for prompts/ratings.
archive/evolution_epochs/national_native_v1/runtime_legacy_untrusted/

# Explicit local third-party quarantines. These may exist in the operator
# checkout, remain untracked, and have zero active import/prompt/evidence
# authority. Active architecture tests enforce that boundary separately.
ref/llm_evolution/
lll/

# One-time legacy-retirement archives (2026-07-14). Preserved on disk for
# forensic continuity; not active source and too bulky to track in Git.
archive/operator_checkout_legacy_bots_20260714/
archive/retired_facilities_20260714/

# ZCode agent session plan cache (per-session scratch, like .claude/worktrees).
.zcode/

# Stray THP match output written outside sever/records/ by a national TCP run.
sever/国赛平台/THP-*.txt

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# LLM credentials
.env
