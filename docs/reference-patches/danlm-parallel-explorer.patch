+"""Multi-Agent Parallel Exploration Framework for DanLM.
+
+Provides a scalable, fault-tolerant system for parallel game exploration
+using multiple AI agent instances. Supports diverse exploration strategies,
+adaptive task allocation, and comprehensive result aggregation.
+
+Architecture:
+    ExplorerCoordinator  — Central orchestrator (task generation, allocation, aggregation)
+    ExplorationWorker    — Per-process worker (game simulation, strategy execution)
+    ExplorationTask      — Typed task descriptor
+    ExplorationResult    — Structured result with statistics and traces
+"""
+
+from __future__ import annotations
+
+from .explorer import (
+    ExplorationMode,
+    ExplorationResult,
+    ExplorationTask,
+    ExplorerCoordinator,
+    StrategyConfig,
+)
+
+__all__ = [
+    "ExplorationMode",
+    "ExplorationResult",
+    "ExplorationTask",
+    "ExplorerCoordinator",
+    "StrategyConfig",
+]
