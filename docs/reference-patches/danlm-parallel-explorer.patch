+#!/usr/bin/env python3
+"""Parallel Exploration CLI for DanLM.
+
+Provides a command-line interface for the multi-agent parallel exploration
+framework. Supports multiple exploration strategies, parallel workers,
+and strategy comparison mode.
+
+Examples:
+    # Basic ε-greedy exploration (4 workers, 100 games)
+    python scripts/parallel_explore.py \
+        --model ckpts/DanLM_v1/dansformer_v1_best_eval.pt \
+        --model-b random \
+        --games 100 --workers 4
+
+    # Strategy comparison: greedy vs ε-greedy vs Boltzmann
+    python scripts/parallel_explore.py \
+        --model ckpts/DanLM_v1/dansformer_v1_best_eval.pt \
+        --model-b random \
+        --games 300 --workers 6 \
+        --compare-strategies
+
+    # Custom exploration with specific ε and temperature
+    python scripts/parallel_explore.py \
+        --model ckpts/DanLM_v1/dansformer_v1_best_eval.pt \
+        --model-b ckpts/DanZero_v3_rep_v1t/v3_rep_v1t_best_eval_001_int8.onnx \
+        --games 200 --workers 8 \
+        --strategy eps_greedy --epsilon 0.2
+
+    # MCTS rollout exploration
+    python scripts/parallel_explore.py \
+        --model ckpts/DanLM_v1/dansformer_v1_best_eval.pt \
+        --games 50 --workers 4 \
+        --strategy mcts --top-k 5 --rollouts 20
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+import time
+
+from danzero.explorer import (
+    ExplorationMode,
+    ExplorerCoordinator,
+    StrategyConfig,
+)
+
+
+def _build_strategy_configs(args: argparse.Namespace) -> list[StrategyConfig]:
+    """Build strategy configurations from CLI arguments."""
+    if args.compare_strategies:
+        # Run all strategies in parallel for comparison
+        return [
+            StrategyConfig(
+                mode=ExplorationMode.GREEDY,
+                epsilon=0.0,
+                seed_offset=0,
+            ),
+            StrategyConfig(
+                mode=ExplorationMode.EPSILON_GREEDY,
+                epsilon=args.epsilon,
+                seed_offset=1_000_000,
+            ),
+            StrategyConfig(
+                mode=ExplorationMode.BOLTZMANN,
+                temperature=args.temperature,
+                seed_offset=2_000_000,
+            ),
+            StrategyConfig(
+                mode=ExplorationMode.DIVERSE,
+                top_k=args.top_k,
+                seed_offset=3_000_000,
+            ),
+        ]
+
+    # Single strategy
+    mode_map = {
+        "greedy": ExplorationMode.GREEDY,
+        "eps_greedy": ExplorationMode.EPSILON_GREEDY,
+        "boltzmann": ExplorationMode.BOLTZMANN,
+        "diverse": ExplorationMode.DIVERSE,
+        "mcts": ExplorationMode.MCTS_ROLLOUT,
+    }
+    mode = mode_map[args.strategy]
+
+    return [
+        StrategyConfig(
+            mode=mode,
+            epsilon=args.epsilon,
+            temperature=args.temperature,
+            top_k=args.top_k,
+            num_rollouts=args.rollouts,
+            rollout_depth=args.rollout_depth,
+        )
+    ]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description="DanLM Multi-Agent Parallel Exploration",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+
+    # Agent specs
+    parser.add_argument("--model", type=str, required=True,
+                        help="Agent A: checkpoint path or spec")
+    parser.add_argument("--model-b", type=str, default="random",
+                        help="Agent B: checkpoint path or spec (default: random)")
+
+    # Game settings
+    parser.add_argument("--games", type=int, default=100,
+                        help="Total number of games (default: 100)")
+    parser.add_argument("--max-rounds", type=int, default=200,
+                        help="Max rounds per game (default: 200)")
+    parser.add_argument("--single-round", action="store_true",
+                        help="Single-round mode instead of full games")
+
+    # Parallel settings
+    parser.add_argument("--workers", type=int, default=4,
+                        help="Number of parallel workers (default: 4)")
+    parser.add_argument("--task-size", type=int, default=10,
+                        help="Games per task chunk (default: 10)")
+    parser.add_argument("--allocation", type=str, default="round_robin",
+                        choices=["round_robin", "dynamic"],
+                        help="Task allocation mode (default: round_robin)")
+    parser.add_argument("--device", type=str, default="cpu",
+                        help="Compute device (default: cpu)")
+
+    # Strategy settings
+    parser.add_argument("--strategy", type=str, default="eps_greedy",
+                        choices=["greedy", "eps_greedy", "boltzmann", "diverse", "mcts"],
+                        help="Exploration strategy (default: eps_greedy)")
+    parser.add_argument("--epsilon", type=float, default=0.1,
+                        help="ε for ε-greedy (default: 0.1)")
+    parser.add_argument("--temperature", type=float, default=0.5,
+                        help="Temperature for Boltzmann (default: 0.5)")
+    parser.add_argument("--top-k", type=int, default=5,
+                        help="Top-k for diverse/MCTS (default: 5)")
+    parser.add_argument("--rollouts", type=int, default=10,
+                        help="Rollouts per action for MCTS (default: 10)")
+    parser.add_argument("--rollout-depth", type=int, default=20,
+                        help="Max rollout depth for MCTS (default: 20)")
+
+    # Special modes
+    parser.add_argument("--compare-strategies", action="store_true",
+                        help="Run all strategies and compare results")
+    parser.add_argument("--seed", type=int, default=42,
+                        help="Base random seed (default: 42)")
+    parser.add_argument("--verbose", action="store_true",
+                        help="Print per-task progress")
+
+    args = parser.parse_args()
+
+    strategies = _build_strategy_configs(args)
+
+    coordinator = ExplorerCoordinator(
+        spec_a=args.model,
+        spec_b=args.model_b,
+        num_games=args.games,
+        num_workers=args.workers,
+        max_rounds=args.max_rounds,
+        base_seed=args.seed,
+        device=args.device,
+        full_game=not args.single_round,
+        strategies=strategies,
+        allocation=args.allocation,
+        task_size=args.task_size,
+    )
+
+    print(f"DanLM Parallel Exploration")
+    print(f"  Agents: {args.model} vs {args.model_b}")
+    print(f"  Games: {args.games} | Workers: {args.workers} | Device: {args.device}")
+    print(f"  Mode: {'full game' if not args.single_round else 'single round'}")
+    print(f"  Strategies: {', '.join(s.mode.value for s in strategies)}")
+    print()
+
+    t0 = time.time()
+
+    if args.compare_strategies:
+        print("--- Strategy Comparison Mode ---")
+        progress = [0]
+
+        def on_progress(completed, total):
+            progress[0] = completed
+            if args.verbose:
+                print(f"  Progress: {completed}/{total} tasks completed")
+
+        results = coordinator.run_with_strategy_comparison(
+            progress_callback=on_progress,
+        )
+
+        elapsed = time.time() - t0
+        print()
+        print(f"{'Strategy':<20} {'Win%':>8} {'W':>6} {'L':>6} {'D':>6} "
+              f"{'Games':>6} {'AvgRnds':>8} {'Time':>8}")
+        print("-" * 80)
+
+        total_games = 0
+        for name, result in sorted(results.items()):
+            decided = result.wins + result.losses
+            wr = f"{result.win_rate:.1%}" if decided > 0 else "N/A"
+            print(f"{name:<20} {wr:>8} {result.wins:>6} {result.losses:>6} "
+                  f"{result.draws:>6} {result.games_played:>6} "
+                  f"{result.avg_rounds:>8.1f} {result.total_duration:>7.1f}s")
+            total_games += result.games_played
+
+        print("-" * 80)
+        print(f"  Total: {total_games} games in {elapsed:.1f}s "
+              f"({elapsed / max(total_games, 1):.2f}s/game)")
+    else:
+        def on_progress(completed, total):
+            if args.verbose:
+                print(f"  Progress: {completed}/{total} tasks completed")
+
+        result = coordinator.run(progress_callback=on_progress)
+        elapsed = time.time() - t0
+
+        print()
+        decided = result.wins + result.losses
+        draws_note = f", {result.draws} draws" if result.draws > 0 else ""
+        print(f"  Result: {result.win_rate:.1%} win rate "
+              f"({result.wins}W/{result.losses}L{draws_note})")
+        print(f"  Games: {result.games_played} | "
+              f"Avg rounds: {result.avg_rounds:.1f}")
+        print(f"  Time: {elapsed:.1f}s ({elapsed / max(result.games_played, 1):.2f}s/game)")
+
+        if result.error:
+            print(f"  WARNING: {result.error}")
+
+
+if __name__ == "__main__":
+    main()
